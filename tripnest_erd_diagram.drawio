        <mxCell id="rel_bk_pot" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="tbl_bookings" target="tbl_payouts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- users -> wishlists (1:N) -->
        <mxCell id="rel_usr_wl" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#db2777;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="tbl_users" target="tbl_wishlists">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
