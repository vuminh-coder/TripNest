@startuml
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 6
skinparam classFontSize 12
skinparam classFontName "Segoe UI", Arial, sans-serif
skinparam classHeaderBackgroundColor #2b3445
skinparam classHeaderFontColor #ffffff
skinparam classBorderColor #4b5563
skinparam classBackgroundColor #ffffff
skinparam arrowColor #ff385c
skinparam arrowThickness 1.5

title <size:18><color:#ff385c><b>TRIPNEST - DATABASE ENTITY RELATIONSHIP DIAGRAM (ERD)</b></color></size>

' ================= ENTITY DEFINITIONS =================

entity "accounts" as accounts <<(A,#ff385c) Tài khoản>> {
  * id : BIGINT <<PK>>
  --
  * email : VARCHAR(191) <<UK>>
  * google_id : VARCHAR(191) <<UK>>
  google_avatar : VARCHAR(500)
  role : ENUM('guest','host','admin')
  status : ENUM('active','inactive','banned')
  email_verified_at : TIMESTAMP
  last_login_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "users" as users <<(U,#2b3445) Hồ sơ cá nhân>> {
  * id : BIGINT <<PK>>
  --
  * account_id : BIGINT <<FK, UK>>
  * full_name : VARCHAR(100)
  phone_number : VARCHAR(20)
  avatar_url : VARCHAR(500)
  gender : ENUM('male','female','other')
  date_of_birth : DATE
  id_card_number : VARCHAR(30)
  nationality : VARCHAR(50)
  address : VARCHAR(255)
  bio : TEXT
  emergency_contact : VARCHAR(150)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "hosts" as hosts <<(H,#0284c7) Chủ sở hữu & KYC>> {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK, UK>>
  * host_display_name : VARCHAR(100)
  host_avatar_url : VARCHAR(500)
  host_introduction : TEXT
  languages_spoken : JSON
  contact_phone : VARCHAR(20)
  contact_email : VARCHAR(191)
  id_card_number : VARCHAR(30)
  id_card_front_url : VARCHAR(500)
  id_card_back_url : VARCHAR(500)
  kyc_status : ENUM('pending','verified','rejected')
  is_superhost : BOOLEAN
  host_rating : DECIMAL(3,2)
  host_reviews_count : INT
  response_rate_percent : TINYINT
  response_time_text : VARCHAR(50)
  terms_accepted_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "host_payout_accounts" as host_payout_accounts <<(P,#0284c7) TK Ngân hàng>> {
  * id : BIGINT <<PK>>
  --
  * host_id : BIGINT <<FK>>
  account_type : ENUM('bank_transfer','momo')
  bank_name : VARCHAR(100)
  bank_code : VARCHAR(20)
  bank_branch : VARCHAR(150)
  account_number : VARCHAR(50)
  account_holder_name : VARCHAR(100)
  currency : VARCHAR(10)
  is_default : BOOLEAN
  is_verified : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "categories" as categories <<(C,#0d9488) Danh mục>> {
  * id : BIGINT <<PK>>
  --
  * slug : VARCHAR(50) <<UK>>
  * label_vi : VARCHAR(100)
  * label_en : VARCHAR(100)
  icon : VARCHAR(50)
  display_order : INT
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "amenities" as amenities <<(T,#0d9488) Tiện nghi>> {
  * id : BIGINT <<PK>>
  --
  * code : VARCHAR(50) <<UK>>
  * name_vi : VARCHAR(100)
  * name_en : VARCHAR(100)
  icon : VARCHAR(50)
  target_type : ENUM('both','accommodation','room')
  category : ENUM('basic','standout','luxury')
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "accommodations" as accommodations <<(R,#4f46e5) Cơ sở lưu trú>> {
  * id : BIGINT <<PK>>
  --
  * host_id : BIGINT <<FK>>
  * category_id : BIGINT <<FK>>
  * name_vi : VARCHAR(255)
  name_en : VARCHAR(255)
  accommodation_type : ENUM('hotel','resort','villa','cabin','yacht')
  star_rating : TINYINT
  description : LONGTEXT
  address : VARCHAR(255)
  city : VARCHAR(100)
  country : VARCHAR(100)
  latitude : DECIMAL(10,8)
  longitude : DECIMAL(11,8)
  distance_description : VARCHAR(255)
  check_in_time : TIME
  check_out_time : TIME
  is_featured : BOOLEAN
  status : ENUM('draft','published','paused')
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "rooms" as rooms <<(M,#e11d48) Phòng & Hạng phòng>> {
  * id : BIGINT <<PK>>
  --
  * accommodation_id : BIGINT <<FK>>
  * room_name_vi : VARCHAR(255)
  room_name_en : VARCHAR(255)
  room_type_code : VARCHAR(50)
  space_type : ENUM('entire_place','private_room')
  description : LONGTEXT
  room_size_m2 : DECIMAL(6,2)
  price_usd_per_night : DECIMAL(10,2)
  price_vnd_per_night : DECIMAL(14,2)
  cleaning_fee_vnd : DECIMAL(12,2)
  service_fee_percent : DECIMAL(4,2)
  max_guests : TINYINT
  bedrooms_count : TINYINT
  beds_count : TINYINT
  bathrooms_count : DECIMAL(3,1)
  rating : DECIMAL(3,2)
  reviews_count : INT
  is_guest_favorite : BOOLEAN
  status : ENUM('available','maintenance')
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "accommodation_images" as accommodation_images <<(I,#4f46e5) Ảnh cơ sở>> {
  * id : BIGINT <<PK>>
  --
  * accommodation_id : BIGINT <<FK>>
  image_url : VARCHAR(500)
  caption : VARCHAR(255)
  display_order : INT
  is_thumbnail : BOOLEAN
}

entity "room_images" as room_images <<(I,#e11d48) Ảnh 5 góc phòng>> {
  * id : BIGINT <<PK>>
  --
  * room_id : BIGINT <<FK>>
  image_url : VARCHAR(500)
  caption : VARCHAR(255)
  display_order : INT
  is_thumbnail : BOOLEAN
}

entity "accommodation_amenity" as accommodation_amenity <<(X,#0d9488) Pivot>> {
  * accommodation_id : BIGINT <<FK>>
  * amenity_id : BIGINT <<FK>>
}

entity "room_amenity" as room_amenity <<(X,#0d9488) Pivot>> {
  * room_id : BIGINT <<FK>>
  * amenity_id : BIGINT <<FK>>
}

entity "bookings" as bookings <<(B,#7c3aed) Đơn đặt phòng>> {
  * id : BIGINT <<PK>>
  --
  * booking_code : VARCHAR(20) <<UK>>
  * user_id : BIGINT <<FK>>
  * room_id : BIGINT <<FK>>
  check_in_date : DATE
  check_out_date : DATE
  nights_count : INT
  guests_count : INT
  base_price : DECIMAL(14,2)
  cleaning_fee : DECIMAL(14,2)
  service_fee : DECIMAL(14,2)
  total_price : DECIMAL(14,2)
  currency : VARCHAR(10)
  status : ENUM('pending','confirmed','completed','cancelled')
  cancellation_reason : VARCHAR(255)
  special_requests : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "reviews" as reviews <<(V,#ea580c) Radar Reviews>> {
  * id : BIGINT <<PK>>
  --
  * booking_id : BIGINT <<FK, UK>>
  * room_id : BIGINT <<FK>>
  * user_id : BIGINT <<FK>>
  rating_overall : DECIMAL(3,2)
  rating_cleanliness : DECIMAL(3,2)
  rating_accuracy : DECIMAL(3,2)
  rating_communication : DECIMAL(3,2)
  rating_location : DECIMAL(3,2)
  rating_checkin : DECIMAL(3,2)
  rating_value : DECIMAL(3,2)
  comment : TEXT
  host_response : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "wishlists" as wishlists <<(W,#db2777) Yêu thích>> {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * room_id : BIGINT <<FK>>
  created_at : TIMESTAMP
}

entity "experiences" as experiences <<(E,#d97706) Trải nghiệm>> {
  * id : BIGINT <<PK>>
  --
  host_id : BIGINT <<FK>>
  title_vi : VARCHAR(255)
  title_en : VARCHAR(255)
  caption : VARCHAR(255)
  city : VARCHAR(100)
  country : VARCHAR(100)
  price_vnd_per_person : DECIMAL(14,2)
  rating : DECIMAL(3,2)
  reviews_count : INT
  image_url : VARCHAR(500)
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "payments" as payments <<(Y,#16a34a) Thanh toán>> {
  * id : BIGINT <<PK>>
  --
  * booking_id : BIGINT <<FK>>
  * transaction_code : VARCHAR(100) <<UK>>
  payment_method : ENUM('credit_card','vnpay','momo','bank_transfer')
  amount : DECIMAL(14,2)
  currency : VARCHAR(10)
  status : ENUM('pending','successful','failed')
  paid_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "payout_transactions" as payout_transactions <<(O,#16a34a) Giải ngân>> {
  * id : BIGINT <<PK>>
  --
  * payout_code : VARCHAR(30) <<UK>>
  * host_id : BIGINT <<FK>>
  booking_id : BIGINT <<FK>>
  * payout_account_id : BIGINT <<FK>>
  gross_amount : DECIMAL(14,2)
  platform_commission_fee : DECIMAL(14,2)
  net_payout_amount : DECIMAL(14,2)
  status : ENUM('pending','completed')
  transferred_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ================= RELATIONSHIPS =================

accounts ||--|| users : "1:1 (xác thực)"
users ||--o| hosts : "1:0..1 (nâng cấp chủ nhà)"
hosts ||--o{ host_payout_accounts : "1:N (TK nhận tiền)"

categories ||--o{ accommodations : "1:N"
hosts ||--o{ accommodations : "1:N"

accommodations ||--o{ rooms : "1:N (gồm nhiều phòng)"
accommodations ||--o{ accommodation_images : "1:N"
rooms ||--o{ room_images : "1:N (5 góc ảnh)"

accommodations ||--o{ accommodation_amenity : "N:N"
amenities ||--o{ accommodation_amenity : "N:N"
rooms ||--o{ room_amenity : "N:N"
amenities ||--o{ room_amenity : "N:N"

users ||--o{ bookings : "1:N (khách đặt)"
rooms ||--o{ bookings : "1:N (phòng được đặt)"

bookings ||--|| reviews : "1:1 (đánh giá sau ở)"
rooms ||--o{ reviews : "1:N"
users ||--o{ reviews : "1:N"

users ||--o{ wishlists : "1:N"
rooms ||--o{ wishlists : "1:N"

bookings ||--o{ payments : "1:N (thanh toán)"
bookings ||--o| payout_transactions : "1:1 (giải ngân)"
host_payout_accounts ||--o{ payout_transactions : "1:N"
hosts ||--o{ experiences : "1:N (tổ chức tour)"

@enduml
